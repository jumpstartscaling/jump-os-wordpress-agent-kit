{
  "tenant_id": "replace-with-private-tenant-id",
  "host": "127.0.0.1",
  "port": 8789,
  "audit_log": "/var/log/jump-tenant-gateway/audit.jsonl",
  "action_timeout_seconds": 300,
  "token_hashes": {
    "viewer": ["replace-with-a-64-character-sha256-hash"],
    "operator": ["replace-with-a-different-64-character-sha256-hash"]
  },
  "status": {
    "role": "viewer",
    "command": ["/usr/bin/sudo", "/usr/local/libexec/tenant-private-status"]
  },
  "operations": {
    "plugin-elementor-update": {
      "role": "operator",
      "command": ["/usr/bin/sudo", "/usr/local/libexec/tenant-private-elementor-update"]
    },
    "plugin-elementor-activate": {
      "role": "operator",
      "command": ["/usr/bin/sudo", "/usr/local/libexec/tenant-private-elementor-activate"]
    }
  }
}
